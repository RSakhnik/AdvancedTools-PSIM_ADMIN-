<Window x:Class="AdvancedTools.BimBridge.ResourceLimitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Bridge — ресурсы и кэш"
        Width="760" MinWidth="680" Height="720" MinHeight="600"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#FFF5F7FB" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF66778C"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,16,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Ресурсы и поисковый кэш" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Индексы Pilot сохраняются на диске и используются повторно, но worker освобождает storage и поисковые сервисы из оперативной памяти после каждого задания."
                       Foreground="#FF5F7188" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#FFEAF1FC" BorderBrush="#FFD6E2F5" BorderThickness="1" CornerRadius="6"
                        Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ResourceStatus}" TextWrapping="Wrap" LineHeight="20"/>
                        <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}"/>
                    </Grid>
                </Border>

                <GroupBox Header="Оперативная память">
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Values"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Минимум для создания нового индекса"/>
                        <TextBox Grid.Column="1" Text="{Binding MinimumAvailableMemoryGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource SettingHint}" Text="Рекомендуется 4 ГБ. После срабатывания ограничителя создание возобновится при 5 ГБ."/>
                        <TextBlock Grid.Row="2" Style="{StaticResource SettingLabel}" Text="Аварийный резерв для готовых индексов"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CriticalAvailableMemoryGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource SettingHint}" Text="Ниже этого значения не запускаются даже уже построенные индексы. Рекомендуется 2 ГБ."/>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                  Content="Разрешать готовые индексы при RAM ниже порога создания"
                                  IsChecked="{Binding AllowExistingSearchIndexesBelowMemoryLimit}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Диск C и создание индексов">
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Values"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Защищённый свободный резерв, ГБ"/>
                        <TextBox Grid.Column="1" Text="{Binding MinimumFreeDiskSpaceGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource SettingHint}" Text="Ниже этого резерва поисковые сервисы не активируются. Рекомендуется 100 ГБ."/>
                        <TextBlock Grid.Row="2" Style="{StaticResource SettingLabel}" Text="Остановить создание индексов при, ГБ"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CacheCreationThresholdGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource SettingHint}" Text="Готовые индексы остаются доступными до защищённого резерва. Рекомендуется 120 ГБ."/>
                        <TextBlock Grid.Row="4" Style="{StaticResource SettingLabel}" Text="Возобновить создание индексов при, ГБ"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CacheResumeThresholdGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Grid.Row="5" Style="{StaticResource SettingHint}" Text="Гистерезис предотвращает постоянное включение и выключение ограничителя. Рекомендуется 125 ГБ."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Ограничения операций">
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Values"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Максимум результатов поиска"/>
                        <TextBox Grid.Column="1" Text="{Binding MaxSearchResults, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource SettingHint}" Text="Допустимо от 100 до 100 000. Поиск выполняется последовательно по частям модели."/>
                        <TextBlock Grid.Row="2" Style="{StaticResource SettingLabel}" Text="Максимум элементов для свойств"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxPropertyElements, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource SettingHint}" Text="Свойства потоково записываются в результат. SDK-сервисы освобождаются после каждого задания."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Пространственные данные">
                    <StackPanel>
                        <TextBlock Text="Максимум узлов обхода на задание"/>
                        <TextBox Text="{Binding MaxSpatialTraversalNodes, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Text="Максимум несжатого JSON, МиБ"/>
                        <TextBox Text="{Binding MaxSpatialResultMiB, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Style="{StaticResource SettingHint}" Text="По умолчанию 100 000 узлов и 64 МиБ. Меши и потомки включаются отдельно в запросе. Числа возвращаются в исходном масштабе SDK, без единиц измерения."/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Ожидание SDK, секунды">
                    <StackPanel>
                        <TextBlock Text="Начало вызова на Dispatcher Pilot"/>
                        <TextBox Text="{Binding SdkDispatcherQueueTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Text="Открытие поискового сервиса, включая очередь и фабрику SDK"/>
                        <TextBox Text="{Binding SearchServiceInitializationTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Text="Ожидание освобождения ресурсов"/>
                        <TextBox Text="{Binding SdkCleanupTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Style="{StaticResource SettingHint}" Text="Рекомендуется 10 / 180 / 15 секунд. Таймаут не прерывает нативный SDK. Общий таймаут задания остаётся верхней границей."/>
                    </StackPanel>
                </GroupBox>
                <TextBlock Text="{Binding Error}" Foreground="#FFC63D3D" TextWrapping="Wrap" Margin="4,0,4,8"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" HorizontalAlignment="Left" Content="Рекомендуемые значения" Command="{Binding ResetCommand}" Margin="0"/>
            <Button Grid.Column="1" Content="Обновить состояние" Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="2" Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True"/>
            <Button Grid.Column="3" Content="Сохранить и применить" Command="{Binding SaveCommand}" IsDefault="True"
                    Background="#FF315EAC" Foreground="White" BorderBrush="#FF315EAC"/>
        </Grid>
    </Grid>
</Window>
