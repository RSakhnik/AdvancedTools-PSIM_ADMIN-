<Window x:Class="AdvancedTools.BimBridge.BimBridgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Bridge — фоновый работник"
        Width="1040"
        Height="800"
        MinWidth="860"
        MinHeight="680"
        Background="#FFF4F6FA"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFDCE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#FFC9D3E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFBFCADA"/>
            <Setter Property="Foreground" Value="#FF24364B"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#FF315EBD"/>
            <Setter Property="BorderBrush" Value="#FF315EBD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#FFA32929"/>
            <Setter Property="BorderBrush" Value="#FFE0BABA"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF66778C"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF172638"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="BIM Bridge" FontSize="25" FontWeight="SemiBold" Foreground="#FF172638"/>
                <TextBlock Text="Связь Pilot-BIM с BIM Workers Manager" Foreground="#FF66778C" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{Binding StateBrush}" CornerRadius="14" Padding="14,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding StateDisplay}" Foreground="White" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Подключение и выполнение" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Text="Экземпляр работника" Style="{StaticResource Caption}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkerInstanceId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent"/>
                    <TextBlock Grid.Row="2" Text="Регистрация" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RegistrationId}" Style="{StaticResource Value}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="3" Text="Текущее задание" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentTaskId}" Style="{StaticResource Value}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="4" Text="Операция" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentOperation}" Style="{StaticResource Value}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="5" Text="Последний heartbeat" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastHeartbeat}" Style="{StaticResource Value}" Margin="0,8,0,0"/>
                </Grid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ресурсы компьютера" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="#FFF3F6FA" CornerRadius="6" Padding="12">
                        <TextBlock Text="{Binding ResourceStatus}" TextWrapping="Wrap" Foreground="#FF34495E" LineHeight="20"/>
                    </Border>
                    <TextBlock Text="Последняя ошибка" FontWeight="SemiBold" Margin="0,13,0,5"/>
                    <TextBlock Text="{Binding LastError}" Foreground="{Binding ErrorBrush}" TextWrapping="Wrap" MaxHeight="56" ToolTip="{Binding LastError}"/>
                    <TextBlock Text="Доступные операции" FontWeight="SemiBold" Margin="0,13,0,5"/>
                    <TextBlock Text="{Binding Capabilities}" TextWrapping="Wrap" Foreground="#FF526477" MaxHeight="46" ToolTip="{Binding Capabilities}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Проекты для загрузки" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Работник обнаруживает и обслуживает модели только внутри выбранных проектов"
                                   Foreground="#FF66778C" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FFF0F4FA" CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
                        <TextBlock Text="{Binding SelectedProjectsSummary}" Foreground="#FF526477"/>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="78" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,10">
                    <ItemsControl ItemsSource="{Binding SelectedProjects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFEAF0FB" BorderBrush="#FFC9D7EE" BorderThickness="1"
                                        CornerRadius="13" Padding="10,4,4,4" Margin="0,0,7,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" MaxWidth="330"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                        <Button Content="×" Width="24" Height="22" Margin="7,0,0,0" Padding="0"
                                                Background="Transparent" BorderThickness="0" Foreground="#FF8B3A3A"
                                                ToolTip="Убрать проект"
                                                Command="{Binding DataContext.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Введите точное название проекта Pilot"
                             KeyDown="ProjectNameTextBox_OnKeyDown"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Добавить проект" Command="{Binding AddProjectCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="10,0,8,0"/>
                    <Button Grid.Column="2" Content="Применить" Command="{Binding ApplyProjectsCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding ProjectSelectionStatus}"
                               Foreground="#FF66778C" Margin="0,7,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <Expander Grid.Row="3" Header="Дополнительные настройки работника" IsExpanded="False" Margin="0,0,0,12" FontWeight="SemiBold">
            <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <CheckBox Content="Автоматическая регистрация" IsChecked="{Binding Settings.AutoRegister}" Margin="0,0,22,0"/>
                        <CheckBox Content="Автоматический запуск" IsChecked="{Binding Settings.AutoStart}" Margin="0,0,22,0"/>
                        <CheckBox Content="Автоматическое переподключение" IsChecked="{Binding Settings.ReconnectEnabled}" Margin="0,0,22,0"/>
                        <CheckBox Content="Диагностические операции" IsChecked="{Binding Settings.DiagnosticOperationsEnabled}"/>
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Резерв диска C, ГБ" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Settings.ResourceLimits.MinimumFreeDiskSpaceGb}"/>
                        <TextBlock Grid.Column="3" Text="Остановить кэш при, ГБ" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="4" Margin="8,0,0,0" Text="{Binding Settings.ResourceLimits.CacheCreationThresholdGb}"/>
                        <TextBlock Grid.Column="6" Text="Свободная RAM, ГБ" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="7" Margin="8,0,0,0" Text="{Binding Settings.ResourceLimits.MinimumAvailableMemoryGb}"/>
                        <TextBlock Grid.Column="9" Text="Сервисы моделей/частей" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="10" Margin="8,0,0,0" Text="{Binding Settings.ResourceLimits.MaxCachedModelSearchServices}"/>
                        <TextBox Grid.Column="12" Text="{Binding Settings.ResourceLimits.MaxCachedPartSearchServices}"/>
                        <Button Grid.Column="14" Content="Сохранить и обновить" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="18,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Expander>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="16,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Каталог BIM-моделей" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ModelsSummary}" Foreground="#FF66778C" Margin="12,3,0,0"/>
                    </StackPanel>
                    <DockPanel Grid.Column="1">
                        <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по названию, GUID или состоянию"/>
                    </DockPanel>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredModels}" BorderThickness="0" Background="White"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" AlternationCount="2">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="13,7"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderBrush" Value="#FFEDF1F6"/>
                            <Setter Property="BorderThickness" Value="0,1,0,0"/>
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#FFF8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFE4ECFC"/>
                                    <Setter Property="Foreground" Value="#FF1E4E9E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12.5" ToolTip="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Скопировать диагностику" Command="{Binding CopyDiagnosticsCommand}" Style="{StaticResource SecondaryButton}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Обновить каталог" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Зарегистрировать" Command="{Binding RegisterCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Запустить" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Остановить" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Отменить регистрацию" Command="{Binding UnregisterCommand}" Style="{StaticResource DangerButton}" Margin="0"/>
            </StackPanel>
        </Grid>

        <Border x:Name="InitializationOverlay" Grid.RowSpan="6" Panel.ZIndex="10"
                Background="#F7FFFFFF" BorderBrush="#FFDCE3EC" BorderThickness="1" CornerRadius="8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                <TextBlock Text="BIM Bridge" FontSize="25" FontWeight="SemiBold" Foreground="#FF172638"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="InitializationText" Text="Подготовка BIM Bridge…"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="#FF526477" Margin="0,0,0,16"/>
                <ProgressBar x:Name="InitializationProgress" Height="6" IsIndeterminate="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
