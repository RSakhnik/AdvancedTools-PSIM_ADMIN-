<Window x:Class="AdvancedTools.Pages.BDLoaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Загрузка отчётов ACCE в БД"
        Width="900" Height="600"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Выбор папки -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
            <RowDefinition Height="*"/>
            <!-- Лог -->
            <RowDefinition Height="Auto"/>
            <!-- Прогресс -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Загрузка отчётов ACCE в БД"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <!-- Выбор папки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Папка с отчётами:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="FolderTextBox"
                     Width="600"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     ToolTip="Путь к папке с файлами отчётов"/>
            <Button x:Name="BrowseButton"
                    Content="Выбрать…"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Click="BrowseButton_Click" />
        </StackPanel>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="StartButton"
                    Content="Загрузить в БД"
                    Padding="16,6"
                    Click="StartButton_Click"/>

            <Button x:Name="TestConnectionButton"
                    Content="Проверить подключение"
                    Padding="12,6"
                    Margin="8,0,0,0"
                    Click="TestConnectionButton_Click"/>

            <Button x:Name="ClearLogButton"
                    Content="Очистить лог"
                    Padding="12,6"
                    Margin="8,0,0,0"
                    Click="ClearLogButton_Click"/>

            <TextBlock x:Name="StatusText"
                       Margin="12,6,0,0"
                       VerticalAlignment="Center"
                       Foreground="Gray"/>
        </StackPanel>

        <!-- Лог -->
        <Grid Grid.Row="3">
            <TextBox x:Name="LogTextBox"
                     FontFamily="Consolas"
                     FontSize="12"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- Прогресс -->
        <ProgressBar x:Name="Progress"
                     Grid.Row="4"
                     Height="10"
                     IsIndeterminate="False"
                     Minimum="0"
                     Maximum="100"
                     Value="0"/>
    </Grid>
</Window>
