<Window x:Class="AdvancedTools.Pages.FilesSizeReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Размер файлов БД"
        Width="1200" Height="760"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FlatBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Анализ размеров файлов БД"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock Text="Источник: Pilot-Storage как в проводнике + Pilot SDK IFile.Size"
                       Foreground="DimGray"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock x:Name="RootTextBlock"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="SummaryTextBlock"
                       Margin="16,0,0,0"
                       Foreground="DimGray"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusTextBlock"
                       Margin="16,0,0,0"
                       Foreground="Gray"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel x:Name="BreadcrumbPanel"
                    Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,10"/>

        <Border Grid.Row="4"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                Padding="12"
                Background="#F6F8FA">
            <Grid>
                <TextBlock x:Name="EmptyChartTextBlock"
                           Text="Подготовка сканирования дерева Pilot..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="Gray"/>

                <ScrollViewer x:Name="ChartScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <Grid MinHeight="382"
                          MinWidth="{Binding ActualWidth, ElementName=ChartScrollViewer}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="300"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="58"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Background="#FFFFFF">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="#E7ECF2"
                                    BorderThickness="0,1,0,0"/>
                            <Border Grid.Row="1"
                                    BorderBrush="#E7ECF2"
                                    BorderThickness="0,1,0,0"/>
                            <Border Grid.Row="2"
                                    BorderBrush="#E7ECF2"
                                    BorderThickness="0,1,0,0"/>
                            <Border Grid.Row="3"
                                    BorderBrush="#E7ECF2"
                                    BorderThickness="0,1,0,0"/>
                            <Border VerticalAlignment="Bottom"
                                    Height="1"
                                    Background="#8A96A3"/>
                        </Grid>

                        <ItemsControl x:Name="ChartItemsControl"
                                      Grid.RowSpan="3">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="110"
                                          Height="382"
                                          Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="300"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="58"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Style="{StaticResource FlatBarButtonStyle}"
                                                ToolTip="{Binding TooltipText}"
                                                Click="BarButton_Click">
                                            <Grid>
                                                <Border Width="68"
                                                        Height="{Binding BarHeight}"
                                                        MinHeight="4"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Bottom"
                                                        Background="{Binding BarBrush}"
                                                        BorderBrush="{Binding BarBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4,4,0,0"
                                                        SnapsToDevicePixels="True"/>
                                            </Grid>
                                        </Button>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding ChartSizeText}"
                                                   Margin="0,5,0,0"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ChartSizeText}"/>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding ShortName}"
                                                   Margin="4,1,4,0"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="54"
                                                   ToolTip="{Binding DisplayName}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <DataGrid x:Name="DetailsDataGrid"
                  Grid.Row="5"
                  Margin="0,12,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  MouseDoubleClick="DetailsDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="2*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding KindText}" Width="100"/>
                <DataGridTextColumn Header="Версия" Binding="{Binding SnapshotText}" Width="160"/>
                <DataGridTextColumn Header="Основной размер" Binding="{Binding PrimarySizeText}" Width="120"/>
                <DataGridTextColumn Header="Основной, байт" Binding="{Binding PrimarySizeBytesText}" Width="135"/>
                <DataGridTextColumn Header="Источник размера" Binding="{Binding PrimarySourceText}" Width="170"/>
                <DataGridTextColumn Header="Storage" Binding="{Binding StorageSizeText}" Width="110"/>
                <DataGridTextColumn Header="Storage, байт" Binding="{Binding StorageSizeBytesText}" Width="135"/>
                <DataGridTextColumn Header="SDK/БД актуальный" Binding="{Binding ActualSizeText}" Width="125"/>
                <DataGridTextColumn Header="SDK/БД акт., байт" Binding="{Binding ActualSizeBytesText}" Width="140"/>
                <DataGridTextColumn Header="SDK/БД всего" Binding="{Binding SizeText}" Width="115"/>
                <DataGridTextColumn Header="SDK/БД всего, байт" Binding="{Binding SizeBytesText}" Width="145"/>
                <DataGridTextColumn Header="Разница" Binding="{Binding MismatchText}" Width="110"/>
                <DataGridTextColumn Header="Разница, байт" Binding="{Binding MismatchBytesText}" Width="135"/>
                <DataGridTextColumn Header="История" Binding="{Binding HistorySizeText}" Width="110"/>
                <DataGridTextColumn Header="Ист., байт" Binding="{Binding HistorySizeBytesText}" Width="135"/>
                <DataGridTextColumn Header="Собственный" Binding="{Binding OwnSizeText}" Width="120"/>
                <DataGridTextColumn Header="Файлов" Binding="{Binding FileCount}" Width="80"/>
                <DataGridTextColumn Header="Акт. файлов" Binding="{Binding ActualFileCount}" Width="90"/>
                <DataGridTextColumn Header="Ист. файлов" Binding="{Binding HistoryFileCount}" Width="90"/>
                <DataGridTextColumn Header="Объектов" Binding="{Binding ObjectCount}" Width="80"/>
                <DataGridTextColumn Header="Тип Pilot" Binding="{Binding TypeTitle}" Width="160"/>
                <DataGridTextColumn Header="Связи" Binding="{Binding RelationText}" Width="180"/>
                <DataGridTextColumn Header="Storage status" Binding="{Binding StorageStateText}" Width="140"/>
                <DataGridTextColumn Header="Storage path" Binding="{Binding StoragePathText}" Width="3*"/>
                <DataGridTextColumn Header="Путь" Binding="{Binding PathText}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="6"
                     Height="10"
                     Margin="0,12,0,0"
                     IsIndeterminate="False"
                     Minimum="0"
                     Maximum="100"
                     Value="0"/>
    </Grid>
</Window>
